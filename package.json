{
  "name": "wyn",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "readiness:env": "node scripts/verify-production-env.mjs",
    "readiness:backup-restore": "bash scripts/backup-restore-test.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@types/node": "22.12.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.21",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "4.1.11",
    "vite": "7.3.5",
    "@types/pg": "8.23.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.5",
      "sharp": "0.35.0",
      "postcss": "8.5.18",
      "fast-xml-parser": "5.5.6"
    }
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
