{
  "name": "@wyn/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wyn/observability build && pnpm --filter @wyn/validation build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@wyn/auth": "workspace:*",
    "@wyn/config": "workspace:*",
    "@wyn/observability": "workspace:*",
    "@wyn/types": "workspace:*",
    "@wyn/validation": "workspace:*",
    "fastify": "5.8.5",
    "fastify-plugin": "5.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
