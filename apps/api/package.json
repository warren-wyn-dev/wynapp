{
  "name": "@wyn/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wyn/observability build && pnpm --filter @wyn/validation build && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --external:argon2 --external:sharp --sourcemap --outfile=dist/server.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@wyn/auth": "workspace:*",
    "@wyn/admin-core": "workspace:*",
    "@wyn/config": "workspace:*",
    "@wyn/observability": "workspace:*",
    "@wyn/types": "workspace:*",
    "@wyn/validation": "workspace:*",
    "fastify": "5.8.5",
    "fastify-plugin": "5.0.1",
    "zod": "4.4.3",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@wyn/database": "workspace:*",
    "@wyn/drop": "workspace:*",
    "@wyn/engagement": "workspace:*",
    "@wyn/notifications": "workspace:*",
    "@wyn/chat": "workspace:*",
    "argon2": "0.44.0",
    "pg": "8.23.0",
    "sharp": "0.35.0",
    "@aws-sdk/client-s3": "3.864.0",
    "@aws-sdk/s3-request-presigner": "3.864.0"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "esbuild": "0.25.12",
    "@types/pg": "8.23.1"
  }
}
