{
  "name": "@wyn/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wyn/observability build && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@wyn/observability": "workspace:*",
    "@wyn/notifications": "workspace:*",
    "@wyn/media": "workspace:*",
    "pg": "8.23.0",
    "zod": "3.24.1",
    "sharp": "0.35.0",
    "@aws-sdk/client-s3": "3.864.0",
    "@aws-sdk/s3-request-presigner": "3.864.0"
  },
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
