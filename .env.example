DATABASE_URL=postgresql://wyn_test:wyn_test@127.0.0.1:5432/wyn_test
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
NODE_ENV=development

# Required only when WYN_ENV=production (apps/api fails fast at startup
# without both). Ignored otherwise — non-production logs email content to
# stdout instead of sending it.
# RESEND_API_KEY=re_...
# EMAIL_FROM=no-reply@wyn.example

# Optional in every environment (apps/api and apps/worker both read it).
# Missing it just means errors go unreported, not a startup failure.
# OBSERVABILITY_DSN=https://<key>@o0.ingest.sentry.io/0
